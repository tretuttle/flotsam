{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Exported types are part of our contracts even before they have consumers.
  "rules": { "types": "off", "nsTypes": "off" },
  "workspaces": {
    "apps/extension": {
      // extension.js builds the pages src/manifest.json names, and scripts/build-experiment.ts bundles the parent script.
      "entry": ["src/*/main.tsx", "experiment/parent.ts", "scripts/*.ts", "extension.config.js"],
      // scripts/minify.test.ts bundles these from entry text, so each resolves to its browser build.
      "ignoreDependencies": ["acorn", "effect", "js-yaml", "vue", "yaml", "zod"],
    },
    "packages/*": {
      // Only package.json `exports` and the tests are entries. Knip's default entries include src/index.ts, which
      // would let a barrel file there pass unused.
      "entry": [],
      // These workspace packages are private to this monorepo.
      "includeEntryExports": true,
    },
    "tools/browser-harness": {
      "includeEntryExports": true,
      // Knip does not resolve these platform process tools.
      "ignoreBinaries": ["taskkill.exe", "powershell.exe", "getconf"],
    },
  },
}
