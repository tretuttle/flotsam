{
  "name": "@one-click-har/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "agent-context:check": "node scripts/agent-context-budget.ts",
    "rename:fix": "node scripts/rename-identifiers.ts",
    "rename:check": "node scripts/rename-identifiers.ts --check",
    "typecheck": "vp run -r --cache typecheck",
    "lint": "vp lint --report-unused-disable-directives",
    "knip": "knip",
    "knip:check": "knip --no-config-hints",
    "test": "vp run -r --concurrency-limit 1 test",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "check": "vp fmt --check && vp lint --report-unused-disable-directives && knip --no-config-hints && vp run typecheck && vp run test && vp run agent-context:check && vp run rename:check"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.1",
    "@types/node": "catalog:",
    "knip": "6.34.0",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "packageManager": "pnpm@12.14.0"
}
