{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "manifest_version": 3,
  "name": "One-Click HAR",
  "version": "0.1.0",
  "description": "Saves a complete HAR of any tab in one click.",
  "browser_specific_settings": {
    "gecko": {
      "id": "har-anytime@tretuttle.github.io",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": {
    "16": "/icons/16.png",
    "32": "/icons/32.png",
    "48": "/icons/48.png",
    "96": "/icons/96.png",
    "128": "/icons/128.png"
  },
  "action": {
    "default_title": "One-Click HAR",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "/icons/16.png",
      "32": "/icons/32.png"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "experiment_apis": {
    "harAnytime": {
      "schema": "experiment/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "experiment/parent.js",
        "paths": [["harAnytime"]]
      }
    }
  }
}
